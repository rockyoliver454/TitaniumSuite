project Titanium_WM is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("main.adb");

   package Compiler is
      -- Strict standard compliance, all warnings active (NASA Rule)
      for Default_Switches ("Ada") use ("-gnat2012", "-gnatwa", "-gnatQ");
   end Compiler;

   package Linker is
      -- Keep in sync with build.sh (-lX11 -lXinerama)
      for Default_Switches ("Ada") use ("-lX11", "-lXinerama");
   end Linker;
end Titanium_WM;
